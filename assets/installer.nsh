!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Welcome to Luno Animate"
  !define MUI_WELCOMEPAGE_TEXT "A little less complicated. A lot more animated.$\r$\n$\r$\nThis wizard will install your friendly, local-first animation studio.$\r$\n$\r$\nDraw, pose characters, and bring your ideas to life. No account or internet connection needed.$\r$\n$\r$\nClick Next to make a little room for your ideas."
  !insertmacro MUI_PAGE_WELCOME
!macroend
