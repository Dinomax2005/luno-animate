{
  "name": "pegbar-studio",
  "version": "2.0.0",
  "private": true,
  "description": "A free, local-first animation studio. Drawing, motion and editing on one unified timeline.",
  "author": "Pegbar Studio",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/prepare.mjs && tsc --noEmit && vite build",
    "test:browser": "playwright test",
    "test:native": "node --test native-tests/*.test.cjs",
    "test:desktop": "playwright test -c playwright.desktop.config.ts",
    "desktop:windows": "npm run build && electron-builder --win --publish never",
    "desktop:mac": "npm run build && electron-builder --mac --publish never",
    "desktop:linux": "npm run build && electron-builder --linux --publish never",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:native"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@noble/hashes": "2.0.1",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "lucide-react": "0.468.0",
    "mediabunny": "1.61.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.10.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "js-yaml": "4.3.2",
    "jsdom": "26.1.0",
    "sharp": "0.35.5",
    "typescript": "5.7.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  },
  "homepage": "https://github.com/Dinomax2005/luno-animate",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dinomax2005/luno-animate.git"
  }
}
