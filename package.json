{
  "name": "luno-animate",
  "version": "0.3.5",
  "private": true,
  "description": "A local-first 2D animation workspace with vector, keyframe, and character-rigging workflows.",
  "author": "Luno Animate contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-desktop.mjs && node scripts/generate-notices.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "desktop:dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://127.0.0.1:5173 && cross-env LUNO_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "desktop:windows": "npm run build && electron-builder --win --publish never",
    "desktop:mac": "npm run build && electron-builder --mac --publish never",
    "desktop:linux": "npm run build && electron-builder --linux --publish never",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:native",
    "test:desktop": "playwright test --config=playwright.desktop.config.ts",
    "test:native": "node scripts/test-native.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.61.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "js-yaml": "^4.3.2",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.1"
  },
  "homepage": "https://github.com/Dinomax2005/luno-animate",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dinomax2005/luno-animate.git"
  }
}
