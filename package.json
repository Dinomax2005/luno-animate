{
  "name": "luno-animate",
  "version": "0.1.0",
  "private": true,
  "description": "A friendly, local-first 2D animation studio with character rigging.",
  "author": "Luno Animate contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/generate-notices.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "desktop:dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://127.0.0.1:5173 && cross-env LUNO_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:windows": "npm run build && electron-builder --win",
    "desktop:mac": "npm run build && electron-builder --mac",
    "desktop:linux": "npm run build && electron-builder --linux",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:desktop": "playwright test --config=playwright.desktop.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "sharp": "^0.33.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.1"
  },
  "homepage": "https://github.com/Dinomax2005/luno-animate",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dinomax2005/luno-animate.git"
  }
}
